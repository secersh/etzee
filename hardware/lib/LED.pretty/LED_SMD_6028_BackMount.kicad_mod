  (attr smd)
  (fp_text reference REF** (at 0 -2.0) (layer B.Fab)
    (effects (font (size 1 1) (thickness 0.15)) (justify mirror))
  )
  (fp_text value LED_SMD_6028_BackMount (at 0 2.0) (layer B.Fab)
    (effects (font (size 1 1) (thickness 0.15)) (justify mirror))
  )

  (fp_line (start -2.94 -1.40) (end  2.94 -1.40) (layer B.Fab) (width 0.10))
  (fp_line (start  2.94 -1.40) (end  2.94  1.40) (layer B.Fab) (width 0.10))
  (fp_line (start  2.94  1.40) (end -2.94  1.40) (layer B.Fab) (width 0.10))
  (fp_line (start -2.94  1.40) (end -2.94 -1.40) (layer B.Fab) (width 0.10))
  (fp_line (start -2.20 -0.40) (end -2.20  0.40) (layer B.Fab) (width 0.12))
  (fp_line (start -2.60  0.00) (end -1.80  0.00) (layer B.Fab) (width 0.12))

  (fp_line (start -3.25 -1.90) (end  3.25 -1.90) (layer B.CrtYd) (width 0.05))
  (fp_line (start  3.25 -1.90) (end  3.25  1.90) (layer B.CrtYd) (width 0.05))
  (fp_line (start  3.25  1.90) (end -3.25  1.90) (layer B.CrtYd) (width 0.05))
  (fp_line (start -3.25  1.90) (end -3.25 -1.90) (layer B.CrtYd) (width 0.05))

  (fp_line (start -2.55 1.70) (end -2.55 1.90) (layer B.SilkS) (width 0.15))
  (fp_line (start -2.75 1.80) (end -2.35 1.80) (layer B.SilkS) (width 0.15))
  (fp_line (start  2.55 1.70) (end  2.55 1.90) (layer B.SilkS) (width 0.15))

  (fp_line (start -1.15 -1.95) (end  1.15 -1.95) (layer Edge.Cuts) (width 0.05))
  (fp_line (start  1.15  1.95) (end -1.15  1.95) (layer Edge.Cuts) (width 0.05))
  (fp_line (start -1.65 -1.45) (end -1.65  1.45) (layer Edge.Cuts) (width 0.05))
  (fp_line (start  1.65  1.45) (end  1.65 -1.45) (layer Edge.Cuts) (width 0.05))
  (fp_arc  (start -1.15 -1.45) (end -1.65 -1.45) (angle 90) (layer Edge.Cuts) (width 0.05))
  (fp_arc  (start  1.15 -1.45) (end  1.15 -1.95) (angle 90) (layer Edge.Cuts) (width 0.05))
