  (fp_arc  (start -1.15  1.45) (end -1.15  1.95) (angle 90) (layer Edge.Cuts) (width 0.05))

  (pad 1 smd roundrect (at -2.55 0) (size 1.4 2.8) (layers B.Cu B.Paste B.Mask) (roundrect_rratio 0.25))
  (pad 2 smd roundrect (at  2.55 0) (size 1.4 2.8) (layers B.Cu B.Paste B.Mask) (roundrect_rratio 0.25))

  (model "${KIPRJMOD}/../../lib/LED.pretty/LED_SMD_6028.step"
