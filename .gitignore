# ── KiCad ────────────────────────────────────────────────────────────────────

# Backups and auto-saves
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_pro-bak
*-backups/
*.bak
*.bck
*.000
*~
_autosave-*
*-save.pro
*-save.kicad_pcb
\#auto_saved_files#
~*.lck

# Local project settings (view state, colour scheme, grid — not shared)
*.kicad_prl

# Footprint cache (regenerated on demand)
fp-info-cache

# KiCad auto-creates .kicad_pro inside .pretty library dirs — ignore them
**/*.pretty/*.kicad_pro

# Netlist exports
*.net

# Autorouter exchange files
*.dsn
*.ses

# Fab outputs (regenerated from board)
*.gbr
*.drl
*.dxf
!hardware/b11/mcad/pcb-outlines/**/*.dxf
gerbers/
fab/

# ── Python scripting ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# ── Firmware ─────────────────────────────────────────────────────────────────
.firmware-cache/

# ── General ──────────────────────────────────────────────────────────────────
*.tmp
*.DS_Store
*.xml
*.csv
.backup/
